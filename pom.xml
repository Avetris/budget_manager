<profiles>
    <profile>
        <id>native</id>
        <build>
            <plugins>
                <plugin>
                    <groupId>org.graalvm.buildtools</groupId>
                    <artifactId>native-maven-plugin</artifactId>
                    <version>0.10.1</version> <!-- Use the latest compatible version -->
                    <extensions>true</extensions>
                    <executions>
                        <execution>
                            <id>build-native</id>
                            <goals>
                                <goal>compile-no-fork</goal> <!-- or compile -->
                            </goals>
                            <phase>package</phase>
                        </execution>
                    </executions>
                    <configuration>
                        <mainClass>com.avetris.App</mainClass> <!-- Replace with your actual main class -->
                        <!-- Add any other necessary build arguments -->
                        <!--
                        <buildArgs>
                            <buildArg>--no-fallback</buildArg>
                        </buildArgs>
                        -->
                    </configuration>
                </plugin>
            </plugins>
        </build>
    </profile>
</profiles>
